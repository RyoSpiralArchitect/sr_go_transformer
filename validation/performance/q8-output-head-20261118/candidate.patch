@@ -168,0 +169,45 @@ func TestQ8BlocksExactAcrossTailsRowsAndWorkers(t *testing.T) {
+func TestQ8OutputPairExact(t *testing.T) {
+	const out = 65
+	e := newKernelExecutor(4)
+	defer e.close()
+	for _, in := range []int{2048, 2049} {
+		w := newInferenceParam("output-pair", out, in, true)
+		for i := range w.Q8.Values {
+			w.Q8.Values[i] = int8(37*i + i/61)
+		}
+		for i := range w.Q8.Scales {
+			w.Q8.Scales[i] = float32(i%13+1) / 65536
+		}
+		x := make([]float32, 3*in)
+		for i := range x {
+			x[i] = float32((13*i)%313-156) / 171
+		}
+		x[3], x[in+5] = math.Float32frombits(1<<31), math.SmallestNonzeroFloat32
+		for _, rows := range []int{1, 2, 3} {
+			want := make([]float32, rows*out)
+			guarded := make([]float32, len(want)+2)
+			guarded[0], guarded[len(guarded)-1] = 123, 456
+			got := guarded[1 : len(guarded)-1]
+			linearQ8Into(e, want, x, w, rows)
+			if rows == 2 && in%q8Block == 0 {
+				// Exercise the paired kernel and its odd tail on every OS.
+				linearQ8OutputPairInto(e, got, x, w)
+				exactWorkerFloats(t, got, want)
+			}
+			for i := range got {
+				got[i] = float32(math.NaN())
+			}
+			linearOutputHeadInto(e, got, x, w, rows)
+			exactWorkerFloats(t, got, want)
+			if guarded[0] != 123 || guarded[len(guarded)-1] != 456 {
+				t.Fatalf("cols=%d rows=%d: sentinel changed", in, rows)
+			}
+		}
+		x[0] = math.MaxFloat32
+		want, got := make([]float32, 2*out), make([]float32, 2*out)
+		linearQ8Into(e, want, x, w, 2)
+		linearOutputHeadInto(e, got, x, w, 2)
+		exactWorkerFloats(t, got, want)
+	}
+}
