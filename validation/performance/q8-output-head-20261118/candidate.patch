+// The large vocabulary projection can reuse the two activation rows across
+// an output pair on Apple Silicon. Other widths and wide sums use the
+// ordinary dispatcher.
+func linearOutputHeadInto(e *kernelExecutor, y, x []float32, w *Param, rows int) {
+	if runtime.GOOS == "darwin" && runtime.GOARCH == "arm64" && rows == 2 &&
+		w.Q4 == nil && w.Q8 != nil && w.Cols%q8Block == 0 && !q8NeedsWideSum(x[:rows*w.Cols]) {
+		linearQ8OutputPairInto(e, y, x, w)
+		return
+	}
+	linearIntoWithExecutor(e, y, x, w, rows)
+}
