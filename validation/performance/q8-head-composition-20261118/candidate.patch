+// Two selected rows can share activation reads across pairs of vocabulary
+// outputs. Keep this path scoped to large aligned Q8 heads on Apple Silicon.
+func linearOutputHeadInto(e *kernelExecutor, y, x []float32, w *Param, rows int) {
+	if runtime.GOOS == "darwin" && runtime.GOARCH == "arm64" && rows == 2 &&
+		e != nil && e.workers >= 2 && w.Rows >= 64<<10 && w.Cols%q8Block == 0 &&
+		w.Q4 == nil && w.Q8 != nil && !q8NeedsWideSum(x[:rows*w.Cols]) {
+		if e.q8HeadFn == nil {
+			e.q8HeadFn = func(lo, hi int) { linearQ8OutputPairRange(&e.linear, lo, hi) }
+		}
+		// Workers borrow this job only until parallel joins. Release the
+		// activation and output slices (and weights) before returning.
+		e.linear = fp32Kernel{x: x, y: y, w: w, n: rows}
+		e.parallel((w.Rows+31)/32, rows*w.Cols*w.Rows, e.q8HeadFn)
+		e.linear = fp32Kernel{}
+		return
+	}
+	linearIntoWithExecutor(e, y, x, w, rows)
+}
