@@ -0,0 +1,97 @@
+// Copyright 2026 RyoSpiralArchitect
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+import (
+	"math"
+	"runtime"
+	"testing"
+)
+
+func q8HeadFixture(in, out int) (*Param, []float32) {
+	w := newInferenceParam("head-exactness", out, in, true)
+	for i := range w.Q8.Values {
+		w.Q8.Values[i] = int8(37*i + i/61)
+	}
+	for i := range w.Q8.Scales {
+		w.Q8.Scales[i] = float32(i%13) / 65536
+	}
+	x := make([]float32, 3*in)
+	for i := range x {
+		x[i] = float32((13*i)%313-156) / 171
+	}
+	x[3], x[5] = math.Float32frombits(1<<31), math.SmallestNonzeroFloat32
+	return w, x
+}
+
+func TestQ8HeadPairParallelOddTail(t *testing.T) {
+	const in, out = 320, 257
+	w, x := q8HeadFixture(in, out)
+	x = x[:2*in]
+	e := newKernelExecutor(4)
+	defer e.close()
+	want := make([]float32, 2*out)
+	linearQ8Into(e, want, x, w, 2)
+	guarded := make([]float32, 2*out+2)
+	guarded[0], guarded[len(guarded)-1] = -12, 13
+	got := guarded[1 : len(guarded)-1]
+	for i := range got {
+		got[i] = float32(math.NaN())
+	}
+	job := fp32Kernel{x: x, y: got, w: w, n: 2}
+	e.parallel((out+31)/32, 2*in*out, func(lo, hi int) { linearQ8OutputPairRange(&job, lo, hi) })
+	exactWorkerFloats(t, got, want)
+	if guarded[0] != -12 || guarded[len(guarded)-1] != 13 {
+		t.Fatal("paired head overwrote output guards")
+	}
+}
+
+func TestQ8HeadDispatchAndExecutorReuse(t *testing.T) {
+	const in, out = 64, 1<<16 + 1
+	w, x := q8HeadFixture(in, out)
+	e := newKernelExecutor(4)
+	defer e.close()
+	got, want := make([]float32, 3*out), make([]float32, 3*out)
+	compare := func(exec *kernelExecutor, rows int, input []float32, weight *Param) {
+		t.Helper()
+		n := rows * weight.Rows
+		linearIntoWithExecutor(exec, want[:n], input, weight, rows)
+		for i := range got[:n] {
+			got[i] = float32(math.NaN())
+		}
+		linearOutputHeadInto(exec, got[:n], input, weight, rows)
+		exactWorkerFloats(t, got[:n], want[:n])
+	}
+	for _, rows := range []int{1, 3} {
+		compare(e, rows, x[:rows*in], w)
+	}
+	unaligned, unalignedInput := q8HeadFixture(in+1, out)
+	compare(e, 2, unalignedInput[:2*(in+1)], unaligned)
+	small, smallInput := q8HeadFixture(in, 33)
+	compare(e, 2, smallInput[:2*in], small)
+	compare(nil, 2, x[:2*in], w)
+	original := x[0]
+	x[0] = math.MaxFloat32
+	compare(e, 2, x[:2*in], w)
+	x[0] = original
+	if e.q8HeadFn != nil {
+		t.Fatal("unexpected dispatch in a fallback case")
+	}
+	compare(e, 2, x[:2*in], w)
+	if runtime.GOOS != "darwin" || runtime.GOARCH != "arm64" {
+		if e.q8HeadFn != nil {
+			t.Fatal("paired head dispatched on an unmeasured platform")
+		}
+		return
+	}
+	if e.q8HeadFn == nil {
+		t.Fatal("paired head did not dispatch for two aligned rows")
+	}
+	if v := testing.AllocsPerRun(5, func() { linearOutputHeadInto(e, got[:2*out], x[:2*in], w, 2) }); v != 0 {
+		t.Fatalf("warm paired output head allocated %.1f objects", v)
+	}
+	if e.linear.x != nil || e.linear.y != nil || e.linear.w != nil || e.linear.n != 0 {
+		t.Fatal("paired head retained a job after the workers joined")
+	}
+}
