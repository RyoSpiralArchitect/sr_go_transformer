+func linearQ8OutputPairRange(job *fp32Kernel, lo, hi int) {
+	y, x, w := job.y, job.x, job.w
+	in, out := w.Cols, w.Rows
+	groups := in / q8Block
+	x0, x1 := x[:in], x[in:2*in]
+	for tile := lo; tile < hi; tile++ {
+		o, end := tile*32, min(out, (tile+1)*32)
+		for ; o+1 < end; o += 2 {
+			w0, w1 := w.Q8.Values[o*in:(o+1)*in], w.Q8.Values[(o+1)*in:(o+2)*in]
+			s0, s1 := w.Q8.Scales[o*groups:(o+1)*groups], w.Q8.Scales[(o+1)*groups:(o+2)*groups]
+			var a00, a01, a10, a11 float32
+			for g := 0; g < groups; g++ {
+				j := g * 64
+				p00, p01, p10, p11 := dotQ8OutputPair64((*[64]float32)(x0[j:j+64]), (*[64]float32)(x1[j:j+64]),
+					(*[64]int8)(w0[j:j+64]), (*[64]int8)(w1[j:j+64]))
+				a00 += p00 * s0[g]
+				a01 += p01 * s1[g]
+				a10 += p10 * s0[g]
+				a11 += p11 * s1[g]
+			}
+			y[o], y[o+1], y[out+o], y[out+o+1] = a00, a01, a10, a11
+		}
+		for ; o < end; o++ {
+			weights := w.Q8.Values[o*in : (o+1)*in]
+			scales := w.Q8.Scales[o*groups : (o+1)*groups]
+			var a0, a1 float32
+			for g, scale := range scales {
+				j := g * 64
+				p0, p1 := dotQ8PairBlock64((*[64]float32)(x0[j:j+64]), (*[64]float32)(x1[j:j+64]),
+					(*[64]int8)(weights[j:j+64]))
+				a0 += p0 * scale
+				a1 += p1 * scale
+			}
+			y[o], y[out+o] = a0, a1
+		}
+	}
+}
