+func TestQ8InvocationWaitsBeforeClearing(t *testing.T) {
+	e := newKernelExecutor(4)
+	x, dense, _ := linearFixture(4, 513, 259)
+	w := quantizeTestParam(t, dense)
+	y, want := make([]float32, 4*w.Rows), make([]float32, 4*w.Rows)
+	baselineLinearQ8Into(e, want, x, w, 4)
+	linearQ8Into(e, y, x, w, 4)
+	standard := e.q8Fn
+	if standard == nil {
+		e.close()
+		t.Fatal("parallel Q8 callback not initialized")
+	}
+	started, release, done := make(chan struct{}, 4), make(chan struct{}), make(chan struct{})
+	e.q8Fn = func(lo, hi int) { started <- struct{}{}; <-release; standard(lo, hi) }
+	go func() { linearQ8Into(e, y, x, w, 4); close(done) }()
+	t.Cleanup(func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+		<-done
+		e.close()
+	})
+	for i := 0; i < 4; i++ {
+		select {
+		case <-started:
+		case <-time.After(5 * time.Second):
+			t.Fatal("Q8 worker did not start")
+		}
+	}
+	select {
+	case <-done:
+		t.Fatal("Q8 returned before worker release")
+	default:
+	}
+	if e.linear.w != w || e.linear.n != 4 || len(e.linear.x) != len(x) || len(e.linear.y) != len(y) {
+		t.Fatal("Q8 state cleared before worker completion")
+	}
+	close(release)
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Q8 workers did not join")
+	}
+	assertQ4InvocationCleared(t, e)
+	exactWorkerFloats(t, y, want)
+	e.q8Fn = standard
+	linearQ8Into(e, y, x, w, 4)
+	exactWorkerFloats(t, y, want)
+	assertQ4InvocationCleared(t, e)
+}
